{
  "manifest_version": 3,
  "name": "SimpleCMS",
  "short_name": "SimpleCMS",
  "version": "1.0.0",
  "description": "Build a simple one-page website in your browser and export it as a ready-to-host zip. No account, no server, nothing uploaded.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SimpleCMS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
